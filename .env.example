# Скопируйте этот файл в .env и заполните. Файл .env никому не показывайте — в нём ключи.

# --- Telegram (обязательно для публикации) ---
# Токен бота от @BotFather
BOT_TOKEN=
# Канал: @имя_канала или числовой id вида -1001234567890. Бот должен быть админом канала.
CHANNEL_ID=

# 1 — ничего не постить, а складывать посты в папку out/ (удобно для проверки)
DRY_RUN=0

# Язык постов: ru или uk
POST_LANGUAGE=ru

# --- ИИ-редактор (необязательно) ---
# Если указать ключ Claude API, прогнозы и обзоры циклонов будет переписывать ИИ «человеческим» языком,
# а описания официальных предупреждений — переводить на русский. Без ключа всё работает на шаблонах.
ANTHROPIC_API_KEY=
# Модель: claude-opus-5-5 (лучшее качество), claude-sonnet-5-5 или claude-haiku-5-5 (дешевле)
AI_MODEL=claude-opus-5-5

# --- Расписание (киевское время). Пустое значение — не публиковать ---
MORNING_TIME=07:30
SYNOPTIC_TIME=09:00
EVENING_TIME=19:00
# Карта осадков на ближайшие 3 часа: времена через запятую, например 06:00,10:00,14:00,18:00,22:00
# (пусто — не публиковать; не чаще ~10 раз в сутки, иначе упрёмся в дневной лимит Open-Meteo)
NOWCAST_TIMES=

# --- Сайт ---
# Бот сам раздаёт сайт с живой картой гроз: http://localhost:8765 (0 — выключить сайт)
SITE_ENABLED=1
SITE_PORT=8765
# 127.0.0.1 — сайт виден только с этого компьютера; 0.0.0.0 — всем устройствам в вашей сети
SITE_HOST=127.0.0.1
# Как часто обновлять разделы сайта, минут: осадки, прогноз, циклоны
SITE_PRECIP_MIN=180
SITE_FORECAST_MIN=180
SITE_SYNOPTIC_MIN=360

# --- Публикация сайта в интернете через GitHub Pages ---
# Бот сам выкладывает копию сайта в ветку репозитория; в настройках репозитория (Settings → Pages)
# источником должна быть эта ветка. Нужен git с доступом на запись в репозиторий.
PAGES_ENABLED=0
PAGES_REMOTE=https://github.com/ВАШ_ЛОГИН/ВАШ_РЕПОЗИТОРИЙ.git
PAGES_BRANCH=gh-pages
# Как часто выкладывать, минут (GitHub собирает Pages не чаще ~10 раз в час)
PAGES_INTERVAL_MIN=6

# --- Съёмка гроз: точка наблюдателя по умолчанию для блока на сайте ---
# Посетитель может сменить точку у себя в браузере; эти значения — то, что он увидит сначала.
SPOTTER_NAME=Киев
SPOTTER_LAT=50.4501
SPOTTER_LON=30.5234
# Высота над землёй, м (этаж, крыша, холм) — от неё зависит дальность горизонта
SPOTTER_HEIGHT=20

# --- Админка: http://localhost:8765/admin ---
# Без пароля открывается только с этого компьютера. Задайте пароль, чтобы входить с телефона или другого ПК
# (и обязательно — если сайт выставлен в интернет).
ADMIN_PASSWORD=

# --- Грозы ---
# Сколько разрядов за 10 минут должно быть в очаге, чтобы о нём писать
ALERT_MIN_STRIKES=15
# На сколько минут вперёд рисовать «конус» движения грозы
FORECAST_MIN=60
# Отдельный пост о грозе выходит, если под ударом город не меньше этого размера
ALERT_CITY_MIN_POP=20000
# Не предупреждать один и тот же город чаще, чем раз в столько минут
REWARN_MIN=45
# Не больше стольких постов о грозах в час (дальше — одна обзорная карта)
MAX_STORM_POSTS_PER_HOUR=8
# Через сколько минут тишины писать «гроза прекратилась» (0 — не писать)
ALL_CLEAR_MIN=45

# --- Официальные предупреждения Укргидрометцентра ---
# Как часто проверять, минут (0 — выключить)
WARNINGS_POLL_MIN=10
# Минимальный уровень: 2 — жёлтый, 3 — оранжевый, 4 — красный
WARNINGS_MIN_LEVEL=2
# Какие типы не публиковать (через запятую): wind, snow-ice, thunderstorm, fog, high-temperature,
# low-temperature, coastalevent, forest-fire, avalanches, rain, flooding, rain-flood
WARNINGS_SKIP_TYPES=coastalevent
# 1 — пропускать предупреждения только для моря и портов
WARNINGS_LAND_ONLY=1
